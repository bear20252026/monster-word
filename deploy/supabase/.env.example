# Monster Word 认证后端配置
#
# 复制为 .env 后填写。.env 含密钥，**不要提交到仓库**（已在 .gitignore 里）。

# ── 对外域名 ──
# 客户端构建时的 AUTH_BASE_URL 必须是 https://<这个值>。
# 内网可用形如 auth.monster-word.lan 的名字（需在 DNS 或 hosts 里能解析到这台机器）。
AUTH_DOMAIN=auth.example.internal

# 用公网域名 + Let's Encrypt 时的联系邮箱；纯内网自签留空即可。
ACME_EMAIL=

# 对外端口。443 被占用时可改成 8443，同时客户端 AUTH_BASE_URL 要带端口。
HTTPS_PORT=443
HTTP_PORT=80

# ── 数据库 ──
# ⚠️ 请在**首次启动前**设好。容器起来后再改这个值，需要手动同步角色密码
#    （见 db/init/01-auth-role.sql 文件头）。
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# ── JWT 签名密钥 ──
# 生成：openssl rand -base64 48
# ⚠️ 泄露 = 任何人可伪造登录态。改动会让所有已签发 token 立即失效（用户需重新登录）。
JWT_SECRET=
